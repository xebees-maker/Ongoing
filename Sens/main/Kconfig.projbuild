menu "Sens Sensor Node"

    choice SENS_BUILD_TARGET
        prompt "Build target"
        default SENS_BUILD_HEADLESS
        help
            Legacy LCD: original Waveshare ESP32-C6-Touch-LCD-1.47 combo app
            (DHT22+SCD41 together, LVGL screen). Kept as-is for existing hardware.

            Headless: new single-sensor node for LOLIN C3 Pico (no display).
            One sensor per physical device, picked below.

        config SENS_BUILD_LEGACY_LCD
            bool "Legacy: Waveshare C6 LCD combo (DHT22+SCD41)"
        config SENS_BUILD_HEADLESS
            bool "Headless: LOLIN C3 Pico single-sensor node"
    endchoice

    choice SENS_SENSOR_TYPE
        prompt "Sensor attached to this node"
        depends on SENS_BUILD_HEADLESS
        default SENS_SENSOR_SCD41
        help
            Only meaningful for the headless build — picks which single sensor
            driver gets compiled in and how ESP-NOW channels are reported.

        config SENS_SENSOR_SCD41
            bool "SCD41 (CO2 + temp + humi)"
        config SENS_SENSOR_DHT22
            bool "DHT22 (temp + humi)"
        config SENS_SENSOR_SHT45
            bool "SHT45 (temp + humi)"
        config SENS_SENSOR_SHT40
            bool "SHT40 (temp + humi)"
        config SENS_SENSOR_MQ137
            bool "MQ137 (ammonia, analog+digital)"
        config SENS_SENSOR_SC05
            bool "SC05-NH3 (ammonia, electrochemical, UART)"
        config SENS_SENSOR_PT100
            bool "PT100 3-wire via MAX31865 (agar temp, SPI)"
        config SENS_SENSOR_SHT45_DS2
            bool "High-temp board: SHT45 (air temp+humi) + DS18B20 x2 (substrate temp, GPIO4/5)"
    endchoice

    # 2026-09-05(사용자 지시: "딥슬립도 캠과 동일한 구조로 가야되") — CAM의
    # CAM_DEEPSLEEP_ENABLE/CAM_DEEPSLEEP_AWAKE_MARGIN_SEC 그대로 이식. 2026-09-12(사용자
    # 지시 — "장치 종류가 달라도 프로토콜은 동일") — 캐스크(딥슬립) 구조를 쓰는 센서 종류가
    # 늘어날 때마다(sens_deep_sleep_node.c로 옮겨진 센서) 여기도 OR로 같이 추가해야 함
    config SENS_DEEPSLEEP_ENABLE
        bool "Deep Sleep 주기적 웨이크 사용"
        default y
        depends on SENS_SENSOR_SCD41 || SENS_SENSOR_MQ137 || SENS_SENSOR_SC05 || SENS_SENSOR_SHT45 || SENS_SENSOR_PT100 || SENS_SENSOR_SHT45_DS2
        help
            꺼면 상시 동작 상태로 남음(콘솔/벤치 작업 시 매 사이클 USB 재열거를 안 겪기 위한
            개발용 이스케이프 해치, CAM의 CAM_DEEPSLEEP_ENABLE과 동일 이유). 켜면 CNTL이
            정해준 샘플 주기로 딥슬립↔웨이크를 반복함(sens_deep_sleep_node.c app_main 참고).

    # 2026-10-25(시험, 사용자 결정) — 이산화탄소 값이 빈 방에서도 단발 측정마다 크게 흔들림(중앙값 34ppm). 연속 측정 모드로
    # 같은 센서를 돌려 흔들림을 비교 — 단발 절차 문제인지 센서 문제인지 가름. 켜면 통신·딥슬립 없이 값만 로그(시험 뒤 끔)
    config SENS_SCD41_PERIODIC_TEST
        bool "SCD41 연속 측정 시험(통신·딥슬립 없음, 로그만)"
        default n
        depends on SENS_SENSOR_SCD41

    # 2026-10-26(시험 A, 사용자 지시 "원인을 찾아") — 연속 모드 시험은 측정 방식과 함께 통신·딥슬립도 꺼져 있었음. 이 시험은
    # 지금 단발 절차(measure_scd41)를 그대로, 같은 간격(약 23.6초)으로 하되 통신·딥슬립만 끔 — 흔들림이 절차 탓인지 통신·전원 탓인지 가름
    config SENS_SCD41_SINGLESHOT_LOOP_TEST
        bool "SCD41 단발 절차 반복 시험(통신·딥슬립 없음, 로그만)"
        default n
        depends on SENS_SENSOR_SCD41 && !SENS_SCD41_PERIODIC_TEST

    # 2026-10-26(시험 B) — 단발 반복 간격(ms). 보통 경로 실측 약 23.6초, 데이터시트가 전제한 간격은 5분(300000)
    config SENS_SCD41_SSLOOP_INTERVAL_MS
        int "단발 반복 시험 간격(ms)"
        default 23600
        depends on SENS_SCD41_SINGLESHOT_LOOP_TEST

    # 2026-10-26(시험 C) — 연속 측정 시험을 저전력 연속 모드(약 30초 주기, 0x21AC)로
    config SENS_SCD41_PERIODIC_LOWPOWER
        bool "연속 측정 시험을 저전력 모드(30초)로"
        default n
        depends on SENS_SCD41_PERIODIC_TEST

    # 2026-10-26(실험, 사용자 설계) — 센서까지 재울 때의 흔들림. 펌웨어 하나로 순서대로(통신·딥슬립 없음, 로그만):
    #  1) 0~30분: 지금과 같은 약 24초 주기 단발(깨우기 → 버리는 측정 → 측정), 측정 뒤 센서 재움 — EXP1
    #  2) 30~90분: 10분마다 센서를 깨워 연속 측정 13개(5초 간격) 기록 후 재움 — EXP2A
    #  3) 90~150분: 10분마다 센서를 깨워 단발 5번 기록 후 재움 — EXP2B
    config SENS_SCD41_SLEEP_EXPERIMENT
        bool "SCD41 센서 재우기 실험(통신·딥슬립 없음, 로그만)"
        default n
        depends on SENS_SENSOR_SCD41 && !SENS_SCD41_PERIODIC_TEST && !SENS_SCD41_SINGLESHOT_LOOP_TEST

    # 2026-10-27(실험, 사용자 설계) — 두 SCD41 보드 교차 비교: 같은 자리, 같은 일정. 10분마다 센서를 깨워 단발 13번 또는 연속 13번 후 재움.
    # 첫 3시간: MAC 끝 0x04 보드(기존) 단발 / 다른 보드 연속, 다음 3시간: 서로 바꿈. 통신·딥슬립 없음, 로그만(XO)
    config SENS_SCD41_CROSSOVER_TEST
        bool "SCD41 두 보드 교차 비교 실험(통신·딥슬립 없음, 로그만)"
        default n
        depends on SENS_SENSOR_SCD41 && !SENS_SCD41_PERIODIC_TEST && !SENS_SCD41_SINGLESHOT_LOOP_TEST && !SENS_SCD41_SLEEP_EXPERIMENT

    # 2026-10-27(실험, 사용자 지시 — 새 보드를 실외에서 1분 이상 연속 측정) — USB가 빠지므로 값을 메모리에 쌓고 30초마다 전부 다시 찍음
    config SENS_SCD41_OUTDOOR_TEST
        bool "SCD41 실외 연속 측정 시험(값을 쌓아 두고 30초마다 다시 출력)"
        default n
        depends on SENS_SENSOR_SCD41 && !SENS_SCD41_PERIODIC_TEST && !SENS_SCD41_SINGLESHOT_LOOP_TEST && !SENS_SCD41_SLEEP_EXPERIMENT && !SENS_SCD41_CROSSOVER_TEST

    config SENS_DEEPSLEEP_AWAKE_MARGIN_SEC
        int "RWDT 깨어있는 시간 마진(초)"
        default 30
        depends on (SENS_SENSOR_SCD41 || SENS_SENSOR_MQ137 || SENS_SENSOR_SC05 || SENS_SENSOR_SHT45 || SENS_SENSOR_PT100 || SENS_SENSOR_SHT45_DS2) && SENS_DEEPSLEEP_ENABLE
        help
            RWDT 예산 = 샘플 주기(딥슬립 주기) + 이 마진. Sens는 사진전송 등 무거운 작업이
            없어 CAM(기본 90)보다 깨어있는 시간이 훨씬 짧아서 기본값을 30으로 낮춤 — 페어링/
            SCD41 측정/CASK 왕복 정도만 덮으면 됨, 실기 측정 후 튜닝 대상.

endmenu

menu "Sens WiFi Dashboard"

    choice SENS_WIFI_MODE
        prompt "WiFi mode"
        default SENS_WIFI_MODE_STA
        help
            STA: connect to an existing AP (dev/test phase, phone on same network).
            AP: C6 hosts its own network (production phase, no router needed).

        config SENS_WIFI_MODE_STA
            bool "Station (join existing WiFi)"
        config SENS_WIFI_MODE_AP
            bool "SoftAP (C6 hosts its own network)"
    endchoice

    config SENS_WIFI_SSID
        string "WiFi SSID"
        default ""
        help
            STA mode: SSID to join. AP mode: SSID this device broadcasts.
            Left empty by default on purpose — this file is committed to git.
            Set the real value in sdkconfig (gitignored), not here.

    config SENS_WIFI_PASSWORD
        string "WiFi password"
        default ""
        help
            STA mode: password for the AP being joined. AP mode: password for this device's own network (min 8 chars, or leave empty for open AP).
            Left empty by default on purpose — this file is committed to git.
            Set the real value in sdkconfig (gitignored), not here.

    config SENS_NODE_NAME
        string "Node name (ESP-NOW identity)"
        default ""
        help
            Human-readable name this node advertises over ESP-NOW and shows on the
            dashboard. Leave empty to auto-generate "Sens-XXXX" from the MAC address.
            Set per-device in sdkconfig (gitignored), not here.

endmenu
