# ESP-IDF build output
build/
sdkconfig
sdkconfig.old

# Font bin files (generated by gen_font.bat)
main/fonts/
fonts.bin

# RTC boot-seed time (regenerated every build by Cntl/tools/gen_time_sync.py)
Cntl/assets_root/time_sync.txt

# Dependencies (managed by idf component manager)
managed_components/
dependencies.lock

# VS Code
.vscode/

# Python cache
__pycache__/
*.pyc

# Claude Code memory (local only) — settings.json is the exception, it travels with git
# (applies at any depth, so per-project Cntl/.claude, Sens/.claude etc. follow the same rule)
**/.claude/*
!**/.claude/settings.json

# Build/flash logs
build_log.txt
flash_log.txt
