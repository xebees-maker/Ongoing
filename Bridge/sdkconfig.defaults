CONFIG_IDF_TARGET="esp32s3"

# 2026-10-02 — 실물 브 보드 Waveshare ESP32-S3-RS485-CAN(ESP32-S3R8: Octal PSRAM 8MB, 16MB 플래시, 화면 없음).
# 예전(09-22~10-01)엔 콘과 같은 4.3B 보드를 빌려 썼음 — PSRAM/플래시 구성이 같아서 아래 설정 그대로
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_FREERTOS_HZ=1000
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y


CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=6144

# 2026-09-26 — 콘솔은 내장 USB(USB-Serial-JTAG)만, UART0 미사용
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# 2026-09-26(설계 6단계 — 브 워치독) — 태스크 워치독(IDLE 태스크 5초 굶음)에 걸리면 재부팅. 콘은 부팅 ID로 재부팅을 알아챔
CONFIG_ESP_TASK_WDT_PANIC=y

# 2026-09-28 — 브 자체 태그(PHOTO/LINK/CAN)의 D 로그를 켤 수 있게(main.c에서 태그별로 켬). IDF 내부는 기본 I 그대로
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
